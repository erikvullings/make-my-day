# Server settings
PORT=7000
CONFIG_DIR=./configs

# Cron schedule for auto-refresh (default: 10 min before every 3rd hour, 05:50–20:50)
# Empty = no scheduled refresh (use only on-demand via /refresh)
REFRESH_INTERVAL=50 5,8,11,14,17,20 * * *

# Cache lifetime in minutes (default: 240 = 4 hours)
CACHE_TTL_MINUTES=240

# Shared browser recycling (prevents memory leaks from long-running Chromium)
# Maximum number of renders before restarting the browser
SHARED_BROWSER_MAX_RENDERS=200
# Maximum age in minutes before restarting the browser
SHARED_BROWSER_MAX_AGE_MINUTES=180

# ============================================================
# Caren.nl credentials (per person)
# ============================================================
# Create one set per household member who needs an agenda on the dashboard.
#
# 1. Log into Caren.nl → Settings → Security → "Extra beveiliging bij het inloggen"
# 2. Enable two-factor auth with an authenticator app (Google Authenticator, Authy, etc.)
# 3. Save the Base32 secret shown (e.g. ABCDEFGHIJKLMNOPQRSTUVWX)
# 4. Uncomment and fill in the variables below

# CAREN_EMMA_USERNAME=emma@example.com
# CAREN_EMMA_PASSWORD=yourpassword
# CAREN_EMMA_TOTP_SECRET=BASE32SECRET
# CAREN_EMMA_PERSON_ID=12345    # Optional: numeric person ID from caren.nl (speeds up fetching)

# CAREN_LIAM_USERNAME=liam@example.com
# CAREN_LIAM_PASSWORD=password
# CAREN_LIAM_TOTP_SECRET=BASE32SECRET
# CAREN_LIAM_PERSON_ID=67890

# ============================================================
# Quote fetcher (optional)
# ============================================================
# Set API key environment variables if the API requires one
# QUOTES_API_KEY=your-api-key   # for zenquotes or quotable APIs
